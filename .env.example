# Application
APP_PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=debt_collection

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_very_long_string
JWT_REFRESH_SECRET=change_me_refresh_secret_very_long_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Debt Collection <your@gmail.com>"

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Chat2Desk (WhatsApp via chat2desk.com) — Settings > API > Token
CHAT2DESK_API_TOKEN=your_chat2desk_api_token
# Chat2Desk channel ID — Settings > Channels > ID column
CHAT2DESK_CHANNEL_ID=your_channel_id
